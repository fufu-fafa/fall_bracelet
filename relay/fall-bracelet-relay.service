[Unit]
Description=FallBracelet relay (events from the wearer's phone to caregivers' phones)
After=network-online.target
Wants=network-online.target

[Service]
User=justsybau
WorkingDirectory=/home/justsybau/fall-bracelet-relay
Environment=PORT=8787
Environment=DB_PATH=/home/justsybau/fall-bracelet-relay/relay.db
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
